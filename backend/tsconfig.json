{
    "compilerOptions": {
      "module": "commonjs",
      "esModuleInterop": true,
      "target": "es6",
      "noImplicitAny": true,
      "moduleResolution": "node",
      "sourceMap": true,
      
      "allowJs": true,
      "lib": ["es6"],
      "outDir": "dist",
      "baseUrl": "src",
      
      "paths": {
        "*": ["node_modules/*"],
        "crypto": [
    "node_modules/crypto-js"
  ],

          "models": [
            "./src/models/*"
      ],
     
        
       
      }
    },
    "include": ["src/**/*", "src/models/.ts"]
  }